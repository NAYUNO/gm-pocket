<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de base -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/gm_blue</item>
        <item name="colorPrimaryDark">@color/gm_blue</item>
        <item name="colorAccent">@color/gm_gold</item>
        <item name="android:windowBackground">@color/gm_blue</item>
    </style>

    <!-- Thème de l'appli une fois lancée : fond bleu (pas de flash blanc) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/gm_blue</item>
        <item name="colorAccent">@color/gm_gold</item>
    </style>

    <!-- Écran de lancement.
         Android 12+ : icône GM Pocket sur fond bleu roi (format imposé par le système).
         Android 11 et moins : image plein écran (drawable/splash). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gm_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
